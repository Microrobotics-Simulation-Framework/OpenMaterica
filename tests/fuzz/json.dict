# libFuzzer dictionary for tests/fuzz/jsonio_bytes.py: JSON tokens, edges and tricky escapes.
# JSON's structure and literals
object_open="{"
object_close="}"
array_open="["
array_close="]"
colon=":"
comma=","
quote="\""
true="true"
false="false"
null="null"
empty_object="{}"
empty_array="[]"
member="\"a\":"
repeated_member="{\"a\":0,\"a\":0}"
# Numbers at the edges of the doubles
minus_zero="-0"
exponent="e+"
exponent_minus="E-"
fraction="0."
largest="1.7976931348623157e308"
rounds_to_infinity="1.7976931348623159e308"
smallest_subnormal="5e-324"
underflow="1e-400"
beyond_2_53="9007199254740993"
# Tokens item 6 refuses
nan="NaN"
infinity="Infinity"
minus_infinity="-Infinity"
comment="/*"
line_comment="//"
# Escapes, the short ones and the tricky ones
escape_quote="\\\""
escape_backslash="\\\\"
escape_slash="\\/"
escape_b="\\b"
escape_u0000="\\u0000"
escape_u001f="\\u001f"
escape_high_surrogate="\\ud800"
escape_low_surrogate="\\udc00"
escape_surrogate_pair="\\ud83d\\ude00"
escape_noncharacter="\\uffff"
escape_upper="\\uDBFF"
# Bytes item 6 refuses
byte_order_mark="\xEF\xBB\xBF"
overlong_nul="\xC0\x80"
encoded_surrogate="\xED\xA0\x80"
truncated_sequence="\xE2\x82"
raw_control="\x01"
raw_nul="\x00"
