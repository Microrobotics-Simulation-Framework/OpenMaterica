#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Git's pre-push hook: refuses a push that would publish a private name or path, in a file, an annotated tag or
# a commit message of what it sends (scripts/check_confidential.py --pre-push; CONTRIBUTING,
# "Confidentiality"). Git gives it the remote's name and URL, and a line for each ref pushed on standard input,
# which the scan reads. It runs the scan of the checkout being pushed from.
#
# The key: the file `git config openmaterica.scanKeyFile` names, else CONFIDENTIAL_SCAN_KEY. With neither, the
# private paths are checked and the names are not, with a warning.
#
# Install it once a clone (hooks live in the common git directory, so every worktree shares it):
#   cp scripts/pre-push "$(git rev-parse --git-path hooks/pre-push)"
#   git config openmaterica.scanKeyFile /path/to/confidential_scan.key    # if you hold the key

if ! grep -q -e "--pre-push" scripts/check_confidential.py 2>/dev/null; then
  echo "pre-push: this checkout's scripts/check_confidential.py has no --pre-push; rebase it onto main" >&2
  exit 1
fi
if key_file=$(git config --get openmaterica.scanKeyFile); then
  exec python3 scripts/check_confidential.py --pre-push "$1" --key-file "$key_file"
fi
exec python3 scripts/check_confidential.py --pre-push "$1"
