{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/materica/schema/0.1/record.reader.json",
  "$comment": "Generated by scripts/gen_reader_schema.py from record.writer.json. Edit the writer schema.",
  "title": "Record",
  "description": "A record as a reader checks it at step 3 of a read (record_format.md section 1 item 2): the envelope, and the body's structure as far as schema 0.1 knows it. Open: members and tokens it does not know pass, and it never applies the shape of a value field, a form or a section's specimen.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "version",
    "name",
    "licence",
    "content_hash",
    "body"
  ],
  "properties": {
    "schema_version": {
      "description": "MAJOR.MINOR.PATCH (record_format.md section 8).",
      "type": "string"
    },
    "record_type": {
      "description": "record_format.md section 3. An interface record's body is specified in a later minor version.",
      "type": "string"
    },
    "id": {
      "description": "<namespace>/<local id> (record_format.md section 7 item 2).",
      "type": "string",
      "pattern": "^[a-z0-9_]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "version": {
      "description": "MAJOR.MINOR.PATCH (record_format.md section 8).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "name": {
      "type": "string"
    },
    "licence": {
      "description": "The licence of the values, an SPDX expression; quoted evidence is never covered by it (record_format.md section 2).",
      "type": "object",
      "required": [
        "values",
        "evidence"
      ],
      "properties": {
        "values": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "content_hash": {
      "description": "record_format.md section 9.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "card": {
      "type": "string"
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "record_type"
        ],
        "properties": {
          "record_type": {
            "const": "material"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "description": "record_format.md section 4.",
            "type": "object",
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "description": "The sections of schema 0.1, every one optional (record_format.md section 4.1).",
                "type": "object",
                "properties": {
                  "bulk": {
                    "description": "record_format.md section 4 item 2.",
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "specimen": true,
                      "fields": {
                        "description": "A field's name to its value field.",
                        "type": "object"
                      }
                    }
                  },
                  "fluid": {
                    "description": "record_format.md section 4 item 2.",
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "specimen": true,
                      "fields": {
                        "description": "A field's name to its value field.",
                        "type": "object"
                      }
                    }
                  },
                  "magnetic": {
                    "description": "record_format.md section 4 item 2.",
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "specimen": true,
                      "fields": {
                        "description": "A field's name to its value field.",
                        "type": "object"
                      }
                    }
                  },
                  "biocompatibility": {
                    "description": "record_format.md section 4 item 2.",
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "specimen": true,
                      "fields": {
                        "description": "A field's name to its value field.",
                        "type": "object"
                      }
                    }
                  }
                }
              },
              "extensions": {
                "description": "A registered namespace to its sections; a reader ignores what it holds (record_format.md section 4 item 4).",
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "record_type"
        ],
        "properties": {
          "record_type": {
            "const": "overlay"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "description": "record_format.md section 4.4.",
            "type": "object",
            "required": [
              "purpose",
              "base",
              "scope",
              "replaces"
            ],
            "properties": {
              "purpose": {
                "type": "string"
              },
              "base": {
                "description": "The one material an overlay replaces fields of (record_format.md section 4.4 item 2).",
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "content_hash"
                ],
                "properties": {
                  "id": {
                    "description": "<namespace>/<local id> (record_format.md section 7 item 2).",
                    "type": "string"
                  },
                  "version": {
                    "description": "MAJOR.MINOR.PATCH (record_format.md section 8).",
                    "type": "string"
                  },
                  "content_hash": {
                    "description": "record_format.md section 9.",
                    "type": "string"
                  }
                }
              },
              "scope": {
                "description": "record_format.md section 4.4 item 3.",
                "type": "object",
                "required": [
                  "consumer"
                ],
                "properties": {
                  "consumer": {
                    "type": "string"
                  },
                  "model": {
                    "description": "A consumer's model, by name and version; the version is the consumer's, not bound by record_format.md section 8.",
                    "type": "object",
                    "required": [
                      "name",
                      "version"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    }
                  },
                  "model_configuration_hash": {
                    "type": "string"
                  },
                  "run": {
                    "type": "string"
                  }
                }
              },
              "replaces": {
                "description": "<section>.<field> to the whole value field that replaces the base's (record_format.md section 4.4 item 2).",
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
