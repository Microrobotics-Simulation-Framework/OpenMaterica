{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/materica/schema/0.1/case.json",
  "$comment": "Hand-edited. The read request and the read result are read_request.json and read_result.json; the package's typed shapes are generated from them.",
  "title": "Case",
  "description": "A conformance case file, one per arm of a case (README.md, \"Case files\").",
  "type": "object",
  "required": ["case", "suite", "schema_version", "inputs", "expected", "compare"],
  "properties": {
    "case": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{3}(?![\\s\\S])"},
    "variant": {"type": "string", "pattern": "^[a-z0-9_]+(?![\\s\\S])"},
    "suite": {"$ref": "#/$defs/suite"},
    "schema_version": {"$ref": "record.writer.json#/$defs/version"},
    "claims": {
      "description": "Each suite the case's answer depends on, and whether the reader claims it.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/suite"},
      "additionalProperties": {"type": "boolean"}
    },
    "inputs": {"$ref": "#/$defs/case_inputs"},
    "request": {
      "description": "A read request, an operation, or, where a case tests the request's own check, any JSON value.",
      "anyOf": [
        {"$ref": "read_request.json"},
        {"$ref": "#/$defs/case_operation"},
        {"$ref": "record.writer.json#/$defs/json_value"}
      ]
    },
    "expected": {
      "description": "The members of the result compared: a read result's, or a table evaluation case's evaluations.",
      "anyOf": [{"$ref": "#/$defs/compared_result"}, {"$ref": "#/$defs/table_evaluations"}]
    },
    "compare": {"$ref": "#/$defs/case_compare"}
  },
  "additionalProperties": false,
  "if": {"required": ["inputs"], "properties": {"inputs": {"required": ["request"]}}},
  "then": {"not": {"required": ["request"]}},
  "else": {"required": ["request"]},
  "allOf": [
    {
      "description": "A table evaluation case (README.md, \"Case files\"): the evaluate operation, no inputs, its evaluations, and a tolerance per precision; every other case, a read result and one tolerance.",
      "if": {"required": ["suite"], "properties": {"suite": {"const": "table_evaluation"}}},
      "then": {
        "required": ["request"],
        "properties": {
          "inputs": {"maxProperties": 0},
          "request": {"$ref": "#/$defs/evaluate_operation"},
          "expected": {"$ref": "#/$defs/table_evaluations"},
          "compare": {
            "required": ["relative_tolerance"],
            "properties": {
              "members": {"const": ["evaluations"]},
              "relative_tolerance": {"$ref": "#/$defs/precision_tolerances"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "expected": {"$ref": "#/$defs/compared_result"},
          "compare": {"properties": {"relative_tolerance": {"type": "number"}}}
        }
      }
    },
    {
      "description": "A read result's status is held wherever compare names it.",
      "if": {
        "required": ["compare"],
        "properties": {"compare": {"required": ["members"], "properties": {"members": {"contains": {"const": "status"}}}}}
      },
      "then": {"properties": {"expected": {"required": ["status"]}}}
    },
    {
      "description": "A read result's reasons are held wherever compare names them.",
      "if": {
        "required": ["compare"],
        "properties": {"compare": {"required": ["members"], "properties": {"members": {"contains": {"const": "reasons"}}}}}
      },
      "then": {"properties": {"expected": {"required": ["reasons"]}}}
    }
  ],
  "$defs": {
    "compared_result": {
      "title": "ComparedResult",
      "description": "The members of a read result a case compares (README.md, \"Case files\": expected holds the members to compare), each as read_result.json gives it (tests/spec_sync/test_schemas.py holds the two lists equal). A case leaves out of compare, and so of expected, a member whose answer the specification leaves open, such as the status and reasons of a no_pick result whose alternatives' own reasons are not yet specified; status and reasons are held wherever compare names them.",
      "type": "object",
      "properties": {
        "status": {"$ref": "read_result.json#/$defs/read_status"},
        "reasons": {"type": "array", "items": {"$ref": "read_result.json#/$defs/reason"}},
        "value": {"$ref": "read_result.json#/$defs/result_value"},
        "alternative_values": {"type": "array", "items": {"$ref": "read_result.json#/$defs/alternative_value"}},
        "unit": {"$ref": "record.writer.json#/$defs/unit"},
        "conditions": {"type": "array", "items": {"$ref": "read_result.json#/$defs/condition_entry"}},
        "specimen": {"$ref": "read_result.json#/$defs/result_specimen"},
        "statistics": {"$ref": "record.writer.json#/$defs/field_statistics"},
        "provenance": {"$ref": "read_result.json#/$defs/result_provenance"},
        "labels": {"type": "array", "items": {"$ref": "read_result.json#/$defs/returned_label"}},
        "assumption": {"$ref": "read_result.json#/$defs/assumption"}
      },
      "additionalProperties": false
    },
    "suite": {
      "enum": [
        "plain_read",
        "hash",
        "scene_documents",
        "fits_and_reference_data",
        "usd_read",
        "table_evaluation",
        "mixing",
        "family_evaluation",
        "sampling",
        "build_checks",
        "record_checks",
        "engine_adapter"
      ]
    },
    "case_inputs": {
      "description": "The files a case supplies, by name in its suite's inputs/.",
      "type": "object",
      "properties": {
        "records": {"type": "array", "items": {"type": "string"}},
        "value": {"type": "string"},
        "request": {"description": "A request that breaks the JSON rules, in place of request.", "type": "string"}
      },
      "additionalProperties": false
    },
    "case_compare": {
      "description": "The result's members compared, and how numbers are: relative_tolerance or exact, never both.",
      "type": "object",
      "required": ["members"],
      "properties": {
        "members": {"type": "array", "items": {"type": "string"}},
        "relative_tolerance": {
          "description": "One relative tolerance, or a table evaluation case's tolerance per precision.",
          "anyOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/precision_tolerances"}]
        },
        "exact": {"type": "boolean"}
      },
      "additionalProperties": false,
      "not": {"required": ["relative_tolerance", "exact"]}
    },
    "case_operation": {
      "description": "A case that is not a read (README.md, \"Operations\"), or a sampling case's draws mapped through a record's structure (README.md, \"Case files\"): the shape of each normal and uniform drawn, and of the result, are not yet specified.",
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": {"enum": ["content_hash", "list_records", "transform_draws", "evaluate"]},
        "normals": {"type": "array", "items": {"$ref": "record.writer.json#/$defs/json_value"}},
        "uniforms": {"type": "array", "items": {"$ref": "record.writer.json#/$defs/json_value"}}
      }
    },
    "evaluate_operation": {
      "description": "A table evaluation case's request (README.md, \"Case files\"): one table as record_format.md section 6 gives it, the axis condition aside, and the axis values it is evaluated at.",
      "type": "object",
      "required": ["operation", "form", "table", "at"],
      "properties": {
        "operation": {"const": "evaluate"},
        "form": {"const": "table"},
        "table": {"$ref": "record.writer.json#/$defs/json_object", "required": ["axis", "axis_unit", "x", "y", "scheme", "edges"]},
        "at": {"type": "array", "items": {"type": "number"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "table_evaluations": {
      "description": "A table evaluation case's expected answer: one entry per axis value, in order.",
      "type": "object",
      "required": ["evaluations"],
      "properties": {"evaluations": {"type": "array", "items": {"$ref": "#/$defs/table_evaluation"}}},
      "additionalProperties": false
    },
    "table_evaluation": {
      "oneOf": [
        {
          "title": "TableEvaluationInside",
          "description": "Inside the readable range, off every edge: the value and the derivative, both sides at an interior knot strictly inside the range, and none where the range is one point.",
          "type": "object",
          "required": ["in_range", "value", "derivative"],
          "properties": {
            "in_range": {"const": true},
            "value": {"type": "number"},
            "derivative": {
              "anyOf": [
                {"type": "number"},
                {"const": "none"},
                {
                  "title": "DerivativeSides",
                  "type": "object",
                  "required": ["left", "right"],
                  "properties": {"left": {"type": "number"}, "right": {"type": "number"}},
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "title": "TableEvaluationRefused",
          "description": "At a declared edge, or across one from the readable range: the refusal, with no number.",
          "type": "object",
          "required": ["refused"],
          "properties": {"refused": {"const": true}},
          "additionalProperties": false
        },
        {
          "title": "TableEvaluationOutside",
          "description": "Elsewhere outside the readable range: the value at its nearest end, taken from inside it, and a derivative of 0.",
          "type": "object",
          "required": ["in_range", "value", "derivative"],
          "properties": {"in_range": {"const": false}, "value": {"type": "number"}, "derivative": {"const": 0}},
          "additionalProperties": false
        }
      ]
    },
    "precision_tolerances": {
      "description": "A table evaluation case's relative tolerance per precision: 1e-12 for binary64, and the file's for binary32.",
      "type": "object",
      "required": ["binary64", "binary32"],
      "properties": {"binary64": {"const": 1e-12}, "binary32": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    }
  }
}
