"""The JSON shapes of records, read requests, read results and case files, as TypedDicts.

Generated by scripts/gen_shapes.py from the schemas in schema/0.1/: edit the schemas. A shape describes; it
never validates. The reader checks what it is given at run time, whatever its type.
"""

from __future__ import annotations

from typing import Literal, NotRequired, TypeAlias, TypedDict, Union

from typing_extensions import ReadOnly

RecordType: TypeAlias = Literal["material", "interface", "overlay"]

RecordId: TypeAlias = str

Version: TypeAlias = str

ContentHash: TypeAlias = str

class Licence(TypedDict):
    """
    The licence of the values, an SPDX expression; quoted evidence is never covered by it (record_format.md
    section 2).
    """

    values: str
    evidence: Literal["excluded"]

class OverlayBase(TypedDict):
    """
    The one material an overlay replaces fields of (record_format.md section 4.4 item 2).
    """

    id: RecordId
    version: Version
    content_hash: ContentHash

class ScopeModel(TypedDict):
    """
    A consumer's model, by name and version; the version is the consumer's, not bound by record_format.md
    section 8.
    """

    name: str
    version: str

class StatusObject(TypedDict):
    """
    A member's status where it has no ordinary value (provenance.md section 1).
    """

    status: Literal["unstated", "not_checked", "none", "not_applicable", "withheld"]
    reason: NotRequired[str]

class MaterialRef(TypedDict):
    """
    A material reference: a record's id and version, and its content hash as the pin.
    """

    id: str
    version: str
    content_hash: str

FieldName: TypeAlias = str

class OperatingValue(TypedDict):
    value: float
    unit: str

class OperatingRange(TypedDict):
    """
    [lo, hi], lo not above hi.
    """

    range: tuple[float, float]
    unit: str

Want: TypeAlias = Literal["value", "bounds", "components", "evidence", "reference_data", "fit", "coverage"]

class Tolerance(TypedDict):
    """
    Absolute, in the condition's registered unit.
    """

    value: float
    unit: str

class AcceptRequirement(TypedDict):
    accept: list[str]

ReadStatus: TypeAlias = Literal["met", "not_met", "unknown"]

