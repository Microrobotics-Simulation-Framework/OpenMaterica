class CaseInputs(TypedDict):
    """
    The files a case supplies, by name in its suite's inputs/.
    """

    records: NotRequired[list[str]]
    value: NotRequired[str]
    request: NotRequired[str]

class CaseCompare(TypedDict):
    """
    The result's members compared, and how numbers are: relative_tolerance or exact, never both.
    """

    members: list[str]
    relative_tolerance: NotRequired[float]
    exact: NotRequired[bool]

class CaseOperation(TypedDict):
    """
    A case that is not a read (README.md, "Operations").
    """

    operation: Literal["content_hash", "list_records"]

class OverlayScope(TypedDict):
    """
    record_format.md section 4.4 item 3.
    """

    consumer: str
    model: NotRequired[ScopeModel]
    model_configuration_hash: NotRequired[str]
    run: NotRequired[str]

class RecordTarget(TypedDict):
    record: MaterialRef
    field: FieldName

class RegionTarget(TypedDict):
    """
    A region of a scene (geometry.md).
    """

    region: str
    field: FieldName

OperatingCondition: TypeAlias = OperatingValue | OperatingRange

class ToleranceRequirement(TypedDict):
    tolerance: Tolerance

class Reason(TypedDict):
    """
    read_side_contract.md section 2; a reason is identified by its code and condition, and detail is for
    people.
    """

    code: ReadOnly[ReasonCode]
    condition: ReadOnly[NotRequired[str]]
    detail: ReadOnly[NotRequired[str]]

Target: TypeAlias = RecordTarget | RegionTarget

RequirementCondition: TypeAlias = ToleranceRequirement | AcceptRequirement

class Requirement(TypedDict):
    want: Want
    conditions: NotRequired[dict[str, RequirementCondition]]

class Record(TypedDict):
    """
    A record as a writer writes it (record_format.md sections 2 to 4.4): its envelope and body structure
    closed, with no member they do not define and every enumerated member limited to its tokens. Value fields,
    specimen facts and extensions are open placeholders until their shapes are written.
    """

    schema_version: Version
    record_type: RecordType
    id: RecordId
    version: Version
    name: str
    licence: Licence
    content_hash: ContentHash
    card: NotRequired[str]
    body: JsonObject

class MaterialBody(TypedDict):
    """
    record_format.md section 4.
    """

    sections: Sections
    extensions: NotRequired[Extensions]

class Sections(TypedDict):
    """
    The sections of schema 0.1, every one optional (record_format.md section 4.1).
    """

    bulk: NotRequired[Section]
    fluid: NotRequired[Section]
    magnetic: NotRequired[Section]
    biocompatibility: NotRequired[Section]

class Section(TypedDict):
    """
    record_format.md section 4 item 2.
    """

    specimen: NotRequired[Specimen]
    fields: Fields

Fields: TypeAlias = dict[str, "ValueField"]
"""
A field's name to its value field.
"""

Extensions: TypeAlias = dict[str, "Extension"]

class OverlayBody(TypedDict):
    """
    record_format.md section 4.4.
    """

    purpose: Literal["fit", "fill_in", "measurement", "scene_override"]
    base: OverlayBase
    scope: OverlayScope
    replaces: Replaces

Replaces: TypeAlias = dict[str, "ValueField"]

ValueField: TypeAlias = "JsonObject"

Specimen: TypeAlias = "JsonObject"

Extension: TypeAlias = "JsonObject"

JsonValue: TypeAlias = Union[bool, float, str, list["JsonValue"], "JsonObject"] | None

JsonObject: TypeAlias = dict[str, JsonValue]

class Case(TypedDict):
    """
    A conformance case file, one per arm of a case (README.md, "Case files").
    """

    case: str
    variant: NotRequired[str]
    suite: Suite
    schema_version: Version
    claims: NotRequired[dict[Suite, bool]]
    inputs: CaseInputs
    request: NotRequired[ReadRequest | CaseOperation | JsonValue]
    expected: ReadResult
    compare: CaseCompare

class ReadRequest(TypedDict):
    """
    read_side_contract.md section 1. A reader checks a request member by member at step 0, refusing with
    reasons, and ignores a member not named here, at any depth.
    """

    target: Target
    operating_conditions: NotRequired[dict[str, OperatingCondition]]
    requirement: Requirement
    acceptances: NotRequired[list[JsonObject]]

class ReadResult(TypedDict):
    """
    read_side_contract.md section 2.
    """

    status: ReadOnly[ReadStatus]
    reasons: ReadOnly[list[Reason]]
    value: ReadOnly[NotRequired[JsonValue]]
    values: ReadOnly[NotRequired[list[JsonValue]]]
    unit: ReadOnly[NotRequired[JsonValue]]
    conditions: ReadOnly[NotRequired[list[JsonObject]]]
    specimen: ReadOnly[NotRequired[JsonObject]]
    statistics: ReadOnly[NotRequired[JsonObject]]
    provenance: ReadOnly[NotRequired[JsonObject]]
    labels: ReadOnly[NotRequired[list[str]]]
    assumption: ReadOnly[NotRequired[JsonObject]]
