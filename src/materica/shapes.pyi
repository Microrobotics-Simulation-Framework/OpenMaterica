Suite: TypeAlias = Literal[
    "plain_read",
    "hash",
    "scene_documents",
    "fits_and_reference_data",
    "usd_read",
    "table_evaluation",
    "mixing",
    "family_evaluation",
    "sampling",
    "build_checks",
    "record_checks",
    "engine_adapter",
